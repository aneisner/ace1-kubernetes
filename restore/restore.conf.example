# restore.conf: Einstellungen für restore-paperless.sh
# Kopiere die Datei nach restore.conf und passe die Werte an. Alles, was
# mit (ANPASSEN) markiert ist, gilt für dein Netz und dein System.

# --- Versionen: dieselben wie auf dem laufenden System
# (Befehle: kubectl get nodes, helm version, helm list -A)
K3S_VERSION="v1.36.5+k3s1"
HELM_VERSION="4.3.1"
METALLB_VERSION="0.16.1"
TRAEFIK_VERSION="42.1.3"
CERTMANAGER_VERSION="v1.21.3"

# --- Der neue Rechner (ANPASSEN)
# Im Ernstfall dieselben Werte wie der alte Server: Name ace1 und die
# Adresse 192.168.88.27. Dieselbe Adresse ist wichtig, weil die
# NFS-Freigabe auf dem NAS nur diese Adresse zulässt.
NODE_NAME="ace1"
NODE_IP="192.168.88.27"

# --- Adressen im Netz (ANPASSEN)
# Bereich, den MetalLB vergeben darf
METALLB_RANGE="192.168.88.240-192.168.88.250"
# Adresse des Ingress; hierhin zeigt paperless.lan
TRAEFIK_IP="192.168.88.240"
# Name der Weboberfläche
SITE_HOST="paperless.lan"

# --- Speicher (ANPASSEN)
# nfs   = Dokumente liegen auf dem NAS (Ernstfall; braucht dieselbe IP
#         wie der alte Server)
# local = leere lokale Volumes, nur für Tests ohne NAS
STORAGE="nfs"

# --- Eingaben, die du mitbringen musst (ANPASSEN)
# Git-Repository mit den YAML-Dateien
REPO_DIR="$HOME/ace1-kubernetes"
# homelab-ca-secret.yaml und paperless-secrets.yaml
SECRETS_DIR="$HOME/secrets-backup"
# neuester Dump (pg_dump -Fc)
DUMP_FILE="$HOME/paperless-latest.dump"
